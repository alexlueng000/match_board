page{background:#0c0c0c;color:#f1e6d0;font-family:-apple-system,BlinkMacSystemFont,'PingFang SC',sans-serif;font-size:28rpx}view,button,input{box-sizing:border-box}.page{position:relative;min-height:100vh;padding:0 32rpx 48rpx}.background{position:fixed;inset:0;width:100%;height:100vh;z-index:0;pointer-events:none;opacity:.68}.content{position:relative;z-index:1}.brand-head{height:180rpx}.brand-head.rewards-head{height:280rpx}.eyebrow{color:#bc9858;font-size:20rpx;letter-spacing:5rpx}.title{font-size:40rpx;font-weight:700;color:#f0d49a;margin:10rpx 0 22rpx}.muted{color:#aca18c;font-size:24rpx;line-height:1.8}.card{background:rgba(15,15,14,.93);border:1rpx solid #695431;border-radius:24rpx;padding:28rpx;margin-bottom:24rpx;box-shadow:0 5rpx 30rpx #0007}.card-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:24rpx;font-size:30rpx;font-weight:600}.more{font-size:24rpx;color:#c9a868;font-weight:400}.profile{display:flex;align-items:center;gap:22rpx}.avatar{width:100rpx;height:100rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center;border-radius:50%;border:2rpx solid #c5a366;background:linear-gradient(145deg,#37301e,#111);font-size:38rpx;color:#efd098}.nickname{font-size:32rpx;font-weight:600}.member-code{color:#a99a7e;font-size:22rpx;margin-top:10rpx}.stats{display:flex;margin-top:30rpx;padding-top:24rpx;border-top:1rpx solid #443920}.stat{flex:1;text-align:center}.stat-value{font-size:42rpx;color:#ebcc8e;font-weight:600}.stat-label{font-size:22rpx;color:#a99b83;margin-top:8rpx}button{font-size:28rpx;border-radius:16rpx;background:#d0ad6a;color:#15130e;padding:8rpx 20rpx;margin:0}button::after{border:0}button[disabled]{background:#6c5a3b;color:#b2a18a}.button-ghost{background:transparent;border:1rpx solid #8a6d3c;color:#d7b67a}.full{width:100%;margin-top:24rpx}.empty{padding:40rpx 18rpx;text-align:center;color:#a99b83;font-size:26rpx;line-height:1.8}.error{padding:20rpx;border:1rpx solid #aa7352;background:#211811;color:#edb99a;border-radius:12rpx;margin-bottom:24rpx;font-size:24rpx}.row{display:flex;align-items:center;gap:20rpx;padding:24rpx 0;border-bottom:1rpx solid #322b1e}.row:last-child{border-bottom:0}.rank{width:48rpx;color:#d7b879;font-size:28rpx}.row-name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.score{color:#edd099;font-size:34rpx}.score-unit{font-size:22rpx;color:#9d8d6e;margin-left:8rpx}.tabs{display:flex;gap:8rpx;background:#141410;border:1rpx solid #645033;border-radius:18rpx;padding:8rpx;margin-bottom:24rpx}.tab{flex:1;text-align:center;padding:16rpx 6rpx;font-size:25rpx;color:#9c8b6c;border-radius:12rpx}.tab.active{background:#cba865;color:#15120c;font-weight:600}.podium{display:flex;align-items:flex-end;gap:14rpx;margin:38rpx 0 28rpx}.podium-item{flex:1;min-width:0;text-align:center;padding:22rpx 8rpx;background:linear-gradient(#211c12,#111);border:1rpx solid #7e6337;border-radius:80rpx 80rpx 14rpx 14rpx}.podium-item.first{padding-top:40rpx;border-color:#dbb66e}.podium-place{color:#e3c382;font-size:32rpx;margin-bottom:12rpx}.podium-avatar{margin:0 auto 15rpx;width:80rpx;height:80rpx;font-size:28rpx}.podium-name{font-size:24rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.podium-score{font-size:34rpx;color:#dfbc7e;margin-top:12rpx}.own-rank{border:1rpx solid #b18b45;color:#e6c58b;padding:22rpx;border-radius:14rpx;margin-bottom:22rpx;background:#18140e}.badge{display:inline-block;padding:6rpx 14rpx;background:#342817;color:#daba78;font-size:22rpx;border-radius:8rpx;margin-top:12rpx}.badge.redeemed{background:#243023;color:#acc09c}.badge.cancelled,.badge.expired{background:#292723;color:#9d9588}.reward-name{font-size:30rpx;font-weight:600;margin-bottom:12rpx}.reward-action{margin-top:22rpx;border-top:1rpx solid #3c3220;padding-top:22rpx;display:flex;justify-content:space-between;align-items:center;color:#d8b879;font-size:24rpx}input{width:100%;background:#181713;border:1rpx solid #645234;border-radius:12rpx;padding:22rpx;color:#eee0c0;height:92rpx;font-size:28rpx;margin-top:16rpx}.field-label{color:#c2ab7c;font-size:26rpx}.note{font-size:23rpx;color:#a8997e;line-height:1.8;margin-top:24rpx}.redeem-code{text-align:center;letter-spacing:7rpx;font-size:52rpx;font-weight:700;color:#f0cc7b;padding:40rpx 0;word-break:break-all}.divider{height:1rpx;background:#413521;margin:24rpx 0}
