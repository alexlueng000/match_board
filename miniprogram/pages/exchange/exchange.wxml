<view class="page"><image class="background" src="{{background}}" mode="aspectFill"/><view class="content"><view class="brand-head"/>
 <view class="card"><view class="title">积分兑换门票</view><view class="muted">兑换消耗可用积分，月赛榜和总榜积分保持不变。</view><block wx:if="{{hasLogin}}"><view class="balance">{{available}}<text> 可用积分</text></view><view class="muted">已兑换消费 · {{spent}} 分</view></block><button wx:else class="full" bindtap="login">微信登录后兑换</button></view>
 <view class="error" wx:if="{{error}}">{{error}}</view><view class="card notice" wx:if="{{notice}}">{{notice}}<button class="full" bindtap="goRewards">查看我的门票</button></view>
 <view class="card" wx:if="{{pending}}"><view class="muted">上一笔兑换结果尚未确认，重复确认不会重复扣分或发票。</view><button class="full" loading="{{busy}}" disabled="{{busy}}" bindtap="confirm">确认上一笔兑换结果</button></view>
 <block wx:if="{{hasLogin}}"><view class="card" wx:for="{{items}}" wx:key="code"><view class="reward-name">{{item.name}}</view><view class="ticket-price">{{item.points}} 积分 / 张</view><view class="muted">{{item.stock===null?'库存充足':'剩余 '+item.stock+' 张'}}</view><button class="full" disabled="{{busy || loading || pending || item.stock===0 || available<item.points}}" data-code="{{item.code}}" bindtap="choose">{{item.stock===0?'暂时兑完':available<item.points?'可用积分不足':'兑换一张'}}</button></view>
 <view class="card empty" wx:if="{{!items.length}}">{{loading?'正在加载兑换门票…':'暂无开放兑换的门票'}}</view>
 <view class="card"><view class="card-heading">兑换记录</view><view class="row" wx:for="{{history}}" wx:key="reward_id"><view class="row-name"><view>{{item.reward_name}}</view><view class="muted">{{item.dateLabel}}</view><view class="muted">{{item.refunded_at?'已撤销，积分已退回':item.status==='redeemed'?'已使用':'待使用'}}</view></view><text class="score">{{item.refunded_at?'已退回':'−'}}{{item.points}} 分</text></view><view class="empty" wx:if="{{!history.length}}">暂无兑换记录</view></view></block>
 </view>
 <view class="exchange-overlay" wx:if="{{selected}}" bindtap="close" catchtouchmove="stopTap"><view class="card exchange-modal" catchtap="stopTap"><view class="title">确认兑换</view><view class="reward-name">{{selected.name}} × 1</view><view class="note">本次消耗 {{selected.points}} 积分，兑换后剩余 {{available-selected.points}} 可用积分。</view><view class="note">月赛榜和总榜积分不变。到店向店员出示会员 ID 即可使用。</view><button class="full" loading="{{busy}}" disabled="{{busy}}" bindtap="confirm">确认兑换</button><button class="full button-ghost" disabled="{{busy}}" bindtap="close">取消</button></view></view>
</view>
