<view class="page"><image class="background" src="{{background}}" mode="aspectFill"/><view class="content"><view class="brand-head"/><view class="eyebrow">27NUTS · 荣誉榜</view><view class="title">{{scope==='monthly'?month+' 月赛积分榜':'累计积分总榜'}}</view><view class="tabs"><view class="tab {{scope==='monthly'?'active':''}}" data-scope="monthly" bindtap="changeScope">月赛榜</view><view class="tab {{scope==='total'?'active':''}}" data-scope="total" bindtap="changeScope">总榜</view></view><view class="error" wx:if="{{error}}" bindtap="load">{{error}} · 点击重试</view><view class="podium" wx:if="{{podium.length}}"><view class="podium-item {{item.rank===1?'first':''}}" wx:for="{{podium}}" wx:key="member_code"><view class="podium-place">{{item.rank===1?'♛':'♕'}} {{item.rank}}</view><view class="avatar podium-avatar">{{item.nickname[0]}}</view><view class="podium-name">{{item.nickname}}</view><view class="podium-score">{{item.score}}<text class="score-unit">分</text></view></view></view><view class="own-rank" wx:if="{{user}}">我的排名 #{{scope==='monthly'?user.monthly_rank:user.total_rank}} · {{scope==='monthly'?user.monthly_score:user.total_score}} 分</view><view class="card"><view class="row" wx:for="{{rows}}" wx:key="member_code"><text class="rank">{{item.rank}}</text><text class="row-name">{{item.nickname}}</text><text class="score">{{item.score}}<text class="score-unit">分</text></text></view><view class="empty" wx:if="{{!rows.length}}">{{loading?'榜单加载中…':podium.length?'更多荣誉，等待你来创造':'暂时没有赛事积分记录'}}</view></view></view></view>
