<view class="page"><image class="background" src="{{background}}" mode="aspectFill"/><view class="content"><view class="brand-head rewards-head"/><view class="error" wx:if="{{error}}" bindtap="load">{{error}} · 点击重试</view><view class="card" wx:if="{{reward}}"><view class="reward-name">{{reward.reward_name}}</view><view class="badge {{reward.status}}">{{reward.statusLabel}}</view><view class="divider"/><view class="muted">获得时间 · {{reward.dateLabel}}</view><view class="muted">来源 · {{reward.source_label || (reward.competition_id?'赛事 #'+reward.competition_id:'门店补发')}}</view><block wx:if="{{reward.status==='pending'}}"><view class="own-rank">会员 ID · {{reward.member_code}}</view><canvas wx:if="{{reward.qr_matrix}}" canvas-id="ticket-qr" class="ticket-qr" style="width:{{qrSize}}px;height:{{qrSize}}px"/><view class="redeem-code">{{reward.redeem_code}}</view><view class="empty" wx:if="{{reward.qr_matrix}}">请向店员出示二维码，扫码确认后使用</view><view class="empty" wx:else>二维码暂不可用，可先向店员出示会员 ID，由店员在后台核销</view><view class="note">请在店员确认前核对奖励内容</view></block><block wx:else><view class="empty">{{reward.status==='redeemed'?'该奖励已使用，不可重复核销':'该奖励已失效或撤销，无法使用'}}</view><view class="muted" wx:if="{{reward.redeemedLabel}}">核销时间 · {{reward.redeemedLabel}}</view></block><button class="full button-ghost" bindtap="load">刷新奖励状态</button></view><view class="card" wx:if="{{!hasLogin}}"><view class="empty">登录后查看奖励详情</view><button class="full" bindtap="login">微信登录</button></view></view></view>
