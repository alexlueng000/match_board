<view class="page"><image class="background" src="{{background}}" mode="aspectFill"/><view class="content"><view class="brand-head"/><view class="error" wx:if="{{error}}" bindtap="load">{{error}} · 点击重试</view><view class="card"><view wx:if="{{user}}"><view class="profile"><view class="avatar">{{user.nickname[0]}}</view><view><view class="nickname">{{user.nickname}}</view><view class="member-code">会员 ID · {{user.member_code}}</view></view></view><view class="stats"><view class="stat"><view class="stat-value">{{user.monthly_score}}</view><view class="stat-label">本月积分</view></view><view class="stat"><view class="stat-value">#{{user.monthly_rank}}</view><view class="stat-label">月赛排名</view></view><view class="stat"><view class="stat-value">{{user.total_score}}</view><view class="stat-label">累计积分</view></view></view></view><view wx:else><view class="title">每一场竞技，皆有荣誉</view><view class="muted">登录后查看自己的积分、排名和赛事奖励</view><button class="full" bindtap="login">微信登录</button></view></view><view class="card"><view class="card-heading"><text>当日比赛</text><text class="more" bindtap="goSessions">查看 / 加入 ›</text></view><view class="row" wx:for="{{sessions}}" wx:key="id" bindtap="goSessions"><view class="row-name"><view>{{item.name}}</view><view class="muted">{{item.timeLabel}} · {{item.enrolled_count}}/{{item.capacity}} 人</view></view><text class="badge">{{item.statusLabel}} ›</text></view><view class="empty" wx:if="{{!sessions.length}}">{{loading?'正在加载比赛…':'今天暂无比赛场次'}}</view></view><view class="card"><view class="card-heading"><text>月赛积分榜</text><text class="more" bindtap="goRanking">完整榜单 ›</text></view><view class="row" wx:for="{{ranks}}" wx:key="member_code"><text class="rank">{{item.rank}}</text><text class="row-name">{{item.nickname}}</text><text class="score">{{item.score}}<text class="score-unit">分</text></text></view><view class="empty" wx:if="{{!ranks.length}}">{{loading?'正在加载榜单…':'新一轮竞技，即将开始'}}</view></view><view class="card"><view class="card-heading"><text>我的奖励</text><text class="more" bindtap="goRewards">全部奖励 ›</text></view><view class="row" wx:for="{{rewards}}" wx:key="id" data-id="{{item.id}}" bindtap="openReward"><text class="row-name">{{item.reward_name}}</text><text class="badge">待核销 ›</text></view><view class="empty" wx:if="{{!rewards.length}}">{{hasLogin?'暂无待核销奖励，期待下一场精彩表现':'登录后查看专属奖励'}}</view></view></view></view>
