/* Keep the native avatar button square instead of using its default width. */
button.avatar-button{width:100rpx!important;min-width:100rpx;max-width:100rpx;height:100rpx;min-height:100rpx;max-height:100rpx;flex:0 0 100rpx;display:flex;align-items:center;justify-content:center;box-sizing:border-box;border-radius:50%;padding:0;margin:0;line-height:normal;overflow:hidden}
.avatar-image{display:block;width:100%;height:100%;border-radius:50%}
