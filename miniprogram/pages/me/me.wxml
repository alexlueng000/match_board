<view class="page"><image class="background" src="{{background}}" mode="aspectFill"/><view class="content"><view class="brand-head"/><view class="title">我的竞技档案</view><view class="error" wx:if="{{error}}">{{error}}</view>
 <view class="card" wx:if="{{user}}">
  <view class="profile">
   <button class="avatar avatar-button" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" disabled="{{busy}}">
    <image wx:if="{{avatarPath || avatarUrl}}" class="avatar-image" src="{{avatarPath || avatarUrl}}" mode="aspectFill"/>
    <text wx:else>{{user.nickname[0]}}</text>
   </button>
   <view><view class="nickname">{{user.nickname}}</view><view class="member-code">会员 ID · {{user.member_code}}</view></view>
  </view>
  <view class="note">点击头像可以更换，填写昵称后保存资料。</view>
  <view class="stats"><view class="stat"><view class="stat-value">{{user.monthly_score}}</view><view class="stat-label">本月积分</view></view><view class="stat"><view class="stat-value">{{user.total_score}}</view><view class="stat-label">累计积分</view></view></view>
  <view class="note">可用积分 · {{user.available_points}} 分（兑换不影响榜单）</view><button class="full button-ghost" bindtap="goExchange">积分兑换门票</button><view class="divider"/><view class="field-label">修改昵称</view>
  <input type="nickname" value="{{nickname}}" maxlength="80" bindinput="nicknameInput" bindblur="nicknameInput" disabled="{{busy}}"/>
  <button class="full" loading="{{busy}}" disabled="{{busy}}" bindtap="save">保存资料</button>
  <button class="full button-ghost" bindtap="logout">退出登录</button>
 </view>
 <view class="card" wx:else><view class="empty">登录后查看你的会员档案</view><button class="full" bindtap="login">微信登录</button></view>
 <view class="card"><view class="card-heading">参赛与奖励说明</view><view class="note">常规赛冠军 / 亚军 / 季军：5 / 3 / 1 分。</view><view class="note">GTO 冠军 / 亚军 / 季军：10 / 6 / 2 分。</view><view class="note">27收池不加分，对应奖励由门店发放。</view><view class="note">月积分按比赛月份归属，总积分累计保留。</view><view class="note">奖励到店出示核销码，由店员确认使用。</view><view class="note">如积分或奖励有疑问，请提供会员 ID 联系店员。</view></view>
</view></view>
