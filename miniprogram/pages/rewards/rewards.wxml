<view class="page"><image class="background" src="{{background}}" mode="aspectFill"/><view class="content"><view class="brand-head rewards-head"/><button class="full exchange-entry" bindtap="goExchange">积分兑换门票 ›</button><view class="tabs"><view class="tab {{tab==='pending'?'active':''}}" data-tab="pending" bindtap="changeTab">待核销</view><view class="tab {{tab==='redeemed'?'active':''}}" data-tab="redeemed" bindtap="changeTab">已核销</view><view class="tab {{tab==='inactive'?'active':''}}" data-tab="inactive" bindtap="changeTab">已失效 / 撤销</view></view><view class="error" wx:if="{{error}}" bindtap="load">{{error}} · 点击重试</view><view class="card" wx:if="{{!hasLogin}}"><view class="empty">登录后查看你的赛事奖励</view><button bindtap="login">微信登录</button></view><block wx:else><view class="card" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="openReward"><view class="reward-name">{{item.reward_name}}</view><view class="muted">获得时间 · {{item.dateLabel}}</view><view class="badge {{item.status}}">{{item.statusLabel}}</view><view class="reward-action"><text>{{item.source_label || (item.competition_id?'赛事奖励':'门店补发奖励')}}</text><text>{{item.status==='pending'?'查看奖励 / 会员 ID ›':'查看记录 ›'}}</text></view></view><view class="card empty" wx:if="{{!rows.length}}">{{loading?'正在加载奖励…':'这里暂时没有奖励记录'}}</view></block></view></view>
